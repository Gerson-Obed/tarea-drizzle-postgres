{
  "name": "tarea-drizzle-postgres",
  "version": "1.0.0",
  "description": "Tarea de Programación 4: Postgres en Docker + Drizzle ORM",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "tsx src/index.ts",
    "build": "tsc",
