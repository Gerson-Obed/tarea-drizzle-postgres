                      "type": "integer",
                      "minimum": 0,
                      "exclusiveMinimum": true
                    },
                    "limit": {
                      "type": "integer",
                      "minimum": 0,
                      "exclusiveMinimum": true
                    },
                    "total": {
                      "type": "integer",
                      "minimum": 0
